<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        name="portal_controlpanel"
        purge="False"
        i18n:domain="collective.autoscaling"
>

  <configlet action_id="autoscaling.settings"
             appId="collective.autoscaling"
             category="Products"
             condition_expr=""
             icon_expr="string:${portal_url}/++resource++autoscaling.png"
             title="Autoscaling"
             url_expr="string:${portal_url}/@@autoscaling-controlpanel"
             visible="True"
             i18n:attributes="title"
  >
    <permission>Manage portal</permission>
  </configlet>

</object>
